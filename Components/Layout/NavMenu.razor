@implements IDisposable

@inject NavigationManager NavigationManager

<div class="sidebar-header">
    <a class="brand" href="">
        <span class="brand-icon">BW</span>

        <span class="brand-text">
            <strong>BudgetWise</strong>
            <small>Personal finance</small>
        </span>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-section-label">Overview</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-grid-1x2-fill nav-icon" aria-hidden="true"></span>
                        Dashboard
                    </NavLink>
                </div>

                <div class="nav-section-label">Budget</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="categories">
                        <span class="bi bi-tags-fill nav-icon" aria-hidden="true"></span>
                        Categories
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="transactions">
                        <span class="bi bi-receipt nav-icon" aria-hidden="true"></span>
                        Transactions
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="budgets">
                        <span class="bi bi-wallet2 nav-icon" aria-hidden="true"></span>
                        Budgets
                    </NavLink>
                </div>

                <div class="nav-section-label">Account</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-circle nav-icon" aria-hidden="true"></span>
                        @context.User.Identity?.Name
                    </NavLink>
                </div>

                <div class="nav-item">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />

                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />

                        <button type="submit" class="nav-link logout-button">
                            <span class="bi bi-box-arrow-left nav-icon" aria-hidden="true"></span>
                            Logout
                        </button>
                    </form>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-section-label">Account</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-box-arrow-in-right nav-icon" aria-hidden="true"></span>
                        Login
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-plus-fill nav-icon" aria-hidden="true"></span>
                        Create Account
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl =
            NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        currentUrl =
            NavigationManager.ToBaseRelativePath(e.Location);

        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}