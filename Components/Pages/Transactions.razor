@page "/transactions"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using cse325_budgetwise.Data
@using cse325_budgetwise.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Transactions</PageTitle>

<div class="container py-4">

    <div class="mb-4">
        <h1>Transactions</h1>

        <p class="text-muted">
            Record and manage your income and expenses.
        </p>
    </div>


    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }


    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }


    @if (isLoading)
    {
        <p>Loading transactions...</p>
    }
    else
    {
        <!-- ADD / EDIT TRANSACTION -->
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h2 class="h5 mb-3">
                    @(IsEditing
                        ? "Edit Transaction"
                        : "Add Transaction")
                </h2>


                @if (categories.Count == 0)
                {
                    <div class="alert alert-warning mb-0">

                        You need to create at least one category
                        before adding a transaction.

                        <a href="/categories" class="alert-link">
                            Create a category
                        </a>

                    </div>
                }
                else
                {
                    <EditForm Model="transactionForm" OnValidSubmit="SaveTransactionAsync" FormName="TransactionForm">

                        <DataAnnotationsValidator />

                        <ValidationSummary class="text-danger mb-3" />


                        <div class="row g-3">

                            <!-- DESCRIPTION -->
                            <div class="col-md-6">

                                <label for="description" class="form-label">
                                    Description
                                </label>

                                <InputText id="description" class="form-control" @bind-Value="transactionForm.Description"
                                           placeholder="Example: Grocery store" />

                                <ValidationMessage For="() => transactionForm.Description" class="text-danger" />

                            </div>


                            <!-- AMOUNT -->
                            <div class="col-md-3">

                                <label for="amount" class="form-label">
                                    Amount
                                </label>

                                <InputNumber id="amount" class="form-control" @bind-Value="transactionForm.Amount" step="0.01"
                                             min="0.01" />

                                <ValidationMessage For="() => transactionForm.Amount" class="text-danger" />

                            </div>


                            <!-- DATE -->
                            <div class="col-md-3">

                                <label for="date" class="form-label">
                                    Date
                                </label>

                                <InputDate id="date" class="form-control" @bind-Value="transactionForm.Date" />

                                <ValidationMessage For="() => transactionForm.Date" class="text-danger" />

                            </div>


                            <!-- TYPE -->
                            <div class="col-md-4">

                                <label for="transactionType" class="form-label">
                                    Type
                                </label>

                                <InputSelect id="transactionType" class="form-select" @bind-Value="transactionForm.Type"
                                             @bind-Value:after="OnTypeChanged">

                                    <option value="@TransactionType.Expense">
                                        Expense
                                    </option>

                                    <option value="@TransactionType.Income">
                                        Income
                                    </option>

                                </InputSelect>

                            </div>


                            <!-- CATEGORY -->
                            <div class="col-md-5">

                                <label for="category" class="form-label">
                                    Category
                                </label>

                                <InputSelect id="category" class="form-select" @bind-Value="transactionForm.CategoryId">

                                    <option value="0">
                                        Select a category
                                    </option>

                                    @foreach (var category in FilteredCategories)
                                    {
                                        <option value="@category.Id">
                                            @category.Name
                                        </option>
                                    }

                                </InputSelect>

                                <ValidationMessage For="() => transactionForm.CategoryId" class="text-danger" />


                                @if (FilteredCategories.Count == 0)
                                {
                                    <div class="form-text text-warning">

                                        You do not have any
                                        @transactionForm.Type.ToString().ToLower()
                                        categories.

                                    </div>
                                }

                            </div>


                            <!-- BUTTONS -->
                            <div class="col-md-3 d-flex align-items-end gap-2">

                                <button type="submit" class="btn btn-primary flex-grow-1" disabled="@isSaving">

                                    @if (isSaving)
                                    {
                                        @(IsEditing
                                            ? "Saving..."
                                            : "Adding...")
                                    }
                                    else
                                    {
                                        @(IsEditing
                                            ? "Save Changes"
                                            : "Add Transaction")
                                    }

                                </button>


                                @if (IsEditing)
                                {
                                    <button type="button" class="btn btn-outline-secondary" disabled="@isSaving"
                                            @onclick="CancelEdit">

                                        Cancel

                                    </button>
                                }

                            </div>

                        </div>

                    </EditForm>
                }

            </div>

        </div>


        <!-- TRANSACTION LIST -->
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="d-flex flex-wrap
                    justify-content-between
                    align-items-center
                    gap-3 mb-3">

                    <h2 class="h5 mb-0">
                        Your Transactions
                    </h2>


                    <div class="d-flex flex-wrap gap-2">

                        <span class="badge text-bg-success fs-6">
                            Income: @(TotalIncome.ToString("C"))
                        </span>

                        <span class="badge text-bg-danger fs-6">
                            Expenses: @(TotalExpenses.ToString("C"))
                        </span>

                        <span class="badge text-bg-primary fs-6">
                            Balance: @(CurrentBalance.ToString("C"))
                        </span>

                    </div>

                </div>


                @if (transactions.Count == 0)
                {
                    <div class="alert alert-light border mb-0">
                        You have not created any transactions yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th>Type</th>
                                    <th class="text-end">
                                        Amount
                                    </th>
                                    <th class="text-end">
                                        Actions
                                    </th>
                                </tr>
                            </thead>


                            <tbody>

                                @foreach (var transaction in transactions)
                                {
                                    <tr class="@(transactionForm.TransactionId == transaction.Id
                                                                                ? "table-primary"
                                                                                : null)">

                                        <!-- DATE -->
                                        <td>
                                            @(transaction.Date.ToString("MMM d, yyyy"))
                                        </td>


                                        <!-- DESCRIPTION -->
                                        <td>
                                            @transaction.Description
                                        </td>


                                        <!-- CATEGORY -->
                                        <td>
                                            @(transaction.Category?.Name
                                                ?? "No category")
                                        </td>


                                        <!-- TYPE -->
                                        <td>

                                            @if (transaction.Type == TransactionType.Income)
                                            {
                                                <span class="badge text-bg-success">
                                                    Income
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-danger">
                                                    Expense
                                                </span>
                                            }

                                        </td>


                                        <!-- AMOUNT -->
                                        <td class="text-end fw-semibold">

                                            @if (transaction.Type == TransactionType.Income)
                                            {
                                                <span class="text-success">
                                                    +@(transaction.Amount.ToString("C"))
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">
                                                    -@(transaction.Amount.ToString("C"))
                                                </span>
                                            }

                                        </td>


                                        <!-- ACTIONS -->
                                        <td class="text-end">

                                            <div class="d-inline-flex gap-2">

                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        disabled="@(isSaving || isDeleting)" @onclick="() => StartEdit(transaction)">

                                                    Edit

                                                </button>


                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        disabled="@(isSaving || isDeleting)"
                                                        @onclick="() => DeleteTransactionAsync(transaction.Id)">

                                                    Delete

                                                </button>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>
    }

</div>


@code {

    // FORM

    [SupplyParameterFromForm(FormName = "TransactionForm")]
    private TransactionFormModel transactionForm { get; set; } = new();


    // DATA

    private List<Category> categories = [];

    private List<Transaction> transactions = [];


    private string? currentUserId;

    private string? errorMessage;

    private string? successMessage;


    private bool isLoading = true;

    private bool isSaving;

    private bool isDeleting;


    // STATE

    private bool IsEditing =>
        transactionForm.TransactionId > 0;


    private List<Category> FilteredCategories =>
        categories
            .Where(category =>
                category.Type == transactionForm.Type)
            .OrderBy(category =>
                category.Name)
            .ToList();


    private decimal TotalIncome =>
        transactions
            .Where(transaction =>
                transaction.Type == TransactionType.Income)
            .Sum(transaction =>
                transaction.Amount);


    private decimal TotalExpenses =>
        transactions
            .Where(transaction =>
                transaction.Type == TransactionType.Expense)
            .Sum(transaction =>
                transaction.Amount);


    private decimal CurrentBalance =>
        TotalIncome - TotalExpenses;


    // LOAD PAGE

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();


            var user =
                await UserManager.GetUserAsync(
                    authenticationState.User);


            if (user is null)
            {
                errorMessage =
                    "You must be signed in to manage transactions.";

                return;
            }


            currentUserId =
                user.Id;


            await LoadCategoriesAsync();


            // If this wasn't populated from a submitted form,
            // initialize a new transaction.
            if (transactionForm.Date == default)
            {
                ResetForm();
            }


            await LoadTransactionsAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load transactions: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    // LOAD CATEGORIES

    private async Task LoadCategoriesAsync()
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        categories =
            await db.Categories
                .AsNoTracking()
                .Where(category =>
                    category.UserId == currentUserId)
                .OrderBy(category =>
                    category.Name)
                .ToListAsync();
    }


    // LOAD TRANSACTIONS

    private async Task LoadTransactionsAsync()
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        transactions =
            await db.Transactions
                .AsNoTracking()
                .Include(transaction =>
                    transaction.Category)
                .Where(transaction =>
                    transaction.UserId == currentUserId)
                .OrderByDescending(transaction =>
                    transaction.Date)
                .ThenByDescending(transaction =>
                    transaction.Id)
                .ToListAsync();
    }


    // TYPE CHANGE

    private void OnTypeChanged()
    {
        transactionForm.CategoryId = 0;

        SetDefaultCategory();
    }


    private void SetDefaultCategory()
    {
        var firstCategory =
            FilteredCategories.FirstOrDefault();


        transactionForm.CategoryId =
            firstCategory?.Id ?? 0;
    }


    // START EDIT

    private void StartEdit(
        Transaction transaction)
    {
        ClearMessages();


        transactionForm =
            new TransactionFormModel
            {
                TransactionId =
                    transaction.Id,

                Description =
                    transaction.Description,

                Amount =
                    transaction.Amount,

                Date =
                    transaction.Date.Date,

                Type =
                    transaction.Type,

                CategoryId =
                    transaction.CategoryId
            };
    }


    // CANCEL EDIT

    private void CancelEdit()
    {
        ClearMessages();

        ResetForm();
    }


    // RESET FORM

    private void ResetForm()
    {
        transactionForm =
            new TransactionFormModel
            {
                TransactionId = 0,

                Date =
                    DateTime.Today,

                Type =
                    TransactionType.Expense
            };


        SetDefaultCategory();
    }


    // SAVE TRANSACTION

    private async Task SaveTransactionAsync()
    {
        ClearMessages();


        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            errorMessage =
                "You must be signed in to save a transaction.";

            return;
        }


        var description =
            transactionForm.Description?.Trim()
            ?? string.Empty;


        if (string.IsNullOrWhiteSpace(description))
        {
            errorMessage =
                "Enter a transaction description.";

            return;
        }


        if (transactionForm.Amount <= 0)
        {
            errorMessage =
                "The transaction amount must be greater than zero.";

            return;
        }


        isSaving = true;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var category =
                await db.Categories
                    .AsNoTracking()
                    .FirstOrDefaultAsync(category =>
                        category.Id ==
                            transactionForm.CategoryId &&
                        category.UserId ==
                            currentUserId);


            if (category is null)
            {
                errorMessage =
                    "Select a valid category.";

                return;
            }


            if (category.Type != transactionForm.Type)
            {
                errorMessage =
                    "The selected category does not match the transaction type.";

                return;
            }


            if (IsEditing)
            {
                await UpdateTransactionAsync(
                    db,
                    description,
                    category.Id);
            }
            else
            {
                await AddTransactionAsync(
                    db,
                    description,
                    category.Id);
            }
        }
        catch (DbUpdateException ex)
        {
            errorMessage =
                $"The transaction could not be saved: " +
                $"{ex.InnerException?.Message ?? ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to save transaction: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }


    // ADD TRANSACTION

    private async Task AddTransactionAsync(
        ApplicationDbContext db,
        string description,
        int categoryId)
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }


        var transactionDate =
            DateTime.SpecifyKind(
                transactionForm.Date.Date,
                DateTimeKind.Utc);


        var transaction =
            new Transaction
            {
                Description =
                    description,

                Amount =
                    transactionForm.Amount,

                Date =
                    transactionDate,

                Type =
                    transactionForm.Type,

                CategoryId =
                    categoryId,

                UserId =
                    currentUserId
            };


        db.Transactions.Add(transaction);


        await db.SaveChangesAsync();


        successMessage =
            "Transaction added successfully.";


        await LoadTransactionsAsync();


        ResetForm();
    }


    // UPDATE TRANSACTION

    private async Task UpdateTransactionAsync(
        ApplicationDbContext db,
        string description,
        int categoryId)
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }


        if (transactionForm.TransactionId <= 0)
        {
            errorMessage =
                "The transaction could not be found.";

            return;
        }


        var transaction =
            await db.Transactions
                .FirstOrDefaultAsync(transaction =>
                    transaction.Id ==
                        transactionForm.TransactionId &&
                    transaction.UserId ==
                        currentUserId);


        if (transaction is null)
        {
            errorMessage =
                "The transaction could not be found.";

            return;
        }


        var transactionDate =
            DateTime.SpecifyKind(
                transactionForm.Date.Date,
                DateTimeKind.Utc);


        transaction.Description =
            description;

        transaction.Amount =
            transactionForm.Amount;

        transaction.Date =
            transactionDate;

        transaction.Type =
            transactionForm.Type;

        transaction.CategoryId =
            categoryId;


        await db.SaveChangesAsync();


        successMessage =
            "Transaction updated successfully.";


        await LoadTransactionsAsync();


        ResetForm();
    }


    // DELETE TRANSACTION

    private async Task DeleteTransactionAsync(
        int transactionId)
    {
        ClearMessages();


        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            errorMessage =
                "You must be signed in to delete a transaction.";

            return;
        }


        isDeleting = true;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var transaction =
                await db.Transactions
                    .FirstOrDefaultAsync(transaction =>
                        transaction.Id ==
                            transactionId &&
                        transaction.UserId ==
                            currentUserId);


            if (transaction is null)
            {
                errorMessage =
                    "The transaction could not be found.";

                return;
            }


            db.Transactions.Remove(transaction);


            await db.SaveChangesAsync();


            if (transactionForm.TransactionId ==
                transactionId)
            {
                ResetForm();
            }


            successMessage =
                "Transaction deleted successfully.";


            await LoadTransactionsAsync();
        }
        catch (DbUpdateException ex)
        {
            errorMessage =
                $"Unable to delete transaction: " +
                $"{ex.InnerException?.Message ?? ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to delete transaction: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
        }
    }


    // MESSAGES

    private void ClearMessages()
    {
        errorMessage = null;

        successMessage = null;
    }


    // FORM MODEL

    private sealed class TransactionFormModel
    {
        public int TransactionId { get; set; }


        [Required(
            ErrorMessage =
                "Enter a description.")]

        [StringLength(
            100,
            MinimumLength = 2,
            ErrorMessage =
                "The description must be between 2 and 100 characters.")]

        public string Description
        {
            get;
            set;
        } = string.Empty;


        [Range(
            typeof(decimal),
            "0.01",
            "999999999.99",
            ErrorMessage =
                "Enter an amount greater than zero.")]

        public decimal Amount
        {
            get;
            set;
        }


        [Required]
        public DateTime Date
        {
            get;
            set;
        }


        [Required]
        public TransactionType Type
        {
            get;
            set;
        } =
            TransactionType.Expense;


        [Range(
            1,
            int.MaxValue,
            ErrorMessage =
                "Select a category.")]

        public int CategoryId
        {
            get;
            set;
        }
    }
}