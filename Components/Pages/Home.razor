@page "/"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using cse325_budgetwise.Data
@using cse325_budgetwise.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>BudgetWise Dashboard</PageTitle>

<div class="container-fluid dashboard-container">

    @* page heading and current month *@
    <div class="dashboard-heading">
        <div>
            <h1>Financial Dashboard</h1>
            <p class="text-muted mb-0">
                An overview of your income, spending, and monthly budgets.
            </p>
        </div>

        <div class="dashboard-month">
            @CurrentMonthName @DateTime.Today.Year
        </div>
    </div>

    @* show any errors that happen while loading the dashboard *@
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @* show a loading spinner while the database information is loading *@
    @if (isLoading)
    {
        <div class="dashboard-loading">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <p class="text-muted mb-0">Loading your dashboard...</p>
        </div>
    }
    else
    {
        @* top summary cards *@
        <div class="row g-4 mb-4">

            @* current account balance *@
            <div class="col-sm-6 col-xl-3">
                <div class="summary-card">
                    <div class="summary-icon balance-icon">
                        <span class="bi bi-wallet2"></span>
                    </div>

                    <div class="summary-label">Current Balance</div>

                    <div class="summary-value
                        @(CurrentBalance >= 0
                             ? "text-success"
                             : "text-danger")">
                        @CurrentBalance.ToString("C")
                    </div>

                    <div class="summary-note">
                        All recorded transactions
                    </div>
                </div>
            </div>

            @* income for the current month *@
            <div class="col-sm-6 col-xl-3">
                <div class="summary-card">
                    <div class="summary-icon income-icon">
                        <span class="bi bi-arrow-up-right"></span>
                    </div>

                    <div class="summary-label">Income This Month</div>

                    <div class="summary-value text-success">
                        @CurrentMonthIncome.ToString("C")
                    </div>

                    <div class="summary-note">
                        @CurrentMonthIncomeCount transaction(s)
                    </div>
                </div>
            </div>

            @* expenses for the current month *@
            <div class="col-sm-6 col-xl-3">
                <div class="summary-card">
                    <div class="summary-icon expense-icon">
                        <span class="bi bi-arrow-down-right"></span>
                    </div>

                    <div class="summary-label">Expenses This Month</div>

                    <div class="summary-value text-danger">
                        @CurrentMonthExpenses.ToString("C")
                    </div>

                    <div class="summary-note">
                        @CurrentMonthExpenseCount transaction(s)
                    </div>
                </div>
            </div>

            @* total remaining across all monthly budgets *@
            <div class="col-sm-6 col-xl-3">
                <div class="summary-card">
                    <div class="summary-icon budget-icon">
                        <span class="bi bi-piggy-bank"></span>
                    </div>

                    <div class="summary-label">Budget Remaining</div>

                    <div class="summary-value
                        @(TotalBudgetRemaining >= 0
                             ? "text-primary"
                             : "text-danger")">
                        @TotalBudgetRemaining.ToString("C")
                    </div>

                    <div class="summary-note">
                        @if (CurrentMonthBudgetTotal == 0)
                        {
                            <span>No budgets set this month</span>
                        }
                        else
                        {
                            <span>
                                @CurrentMonthExpenses.ToString("C")
                                of @CurrentMonthBudgetTotal.ToString("C")
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">

            @* six month income and expense chart *@
            <div class="col-xl-8">
                <div class="dashboard-card h-100">
                    <div class="card-heading">
                        <div>
                            <h2>Six-Month Report</h2>
                            <p>
                                Monthly income compared with monthly expenses.
                            </p>
                        </div>
                    </div>

                    @if (monthlyReports.All(report =>
                        report.Income == 0 && report.Expenses == 0))
                    {
                        <div class="empty-state">
                            <span class="bi bi-bar-chart"></span>
                            <p>
                                Add transactions to see your monthly report.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="chart-legend">
                            <span>
                                <span class="legend-dot income-dot"></span>
                                Income
                            </span>

                            <span>
                                <span class="legend-dot expense-dot"></span>
                                Expenses
                            </span>
                        </div>

                        <div class="monthly-chart">
                            @foreach (var report in monthlyReports)
                            {
                                <div class="month-column">
                                    <div class="month-values">
                                        <span class="income-value">
                                            @FormatShortCurrency(report.Income)
                                        </span>

                                        <span class="expense-value">
                                            @FormatShortCurrency(report.Expenses)
                                        </span>
                                    </div>

                                    <div class="bar-area">
                                        <div class="chart-bar income-bar" title="Income: @report.Income.ToString("C")"
                                             style="@GetBarHeightStyle(report.Income)">
                                        </div>

                                        <div class="chart-bar expense-bar" title="Expenses: @report.Expenses.ToString("C")"
                                             style="@GetBarHeightStyle(report.Expenses)">
                                        </div>
                                    </div>

                                    <div class="month-label">
                                        @report.MonthLabel
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* current month spending grouped by category *@
            <div class="col-xl-4">
                <div class="dashboard-card h-100">
                    <div class="card-heading">
                        <div>
                            <h2>Spending by Category</h2>
                            <p>
                                Expenses during @CurrentMonthName.
                            </p>
                        </div>
                    </div>

                    @if (categorySpending.Count == 0)
                    {
                        <div class="empty-state">
                            <span class="bi bi-pie-chart"></span>
                            <p>
                                No expenses have been recorded this month.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="category-chart">
                            @foreach (var row in categorySpending)
                            {
                                <div class="category-row">
                                    <div class="category-row-heading">
                                        <span>@row.CategoryName</span>
                                        <strong>@row.Amount.ToString("C")</strong>
                                    </div>

                                    <div class="category-track">
                                        <div class="category-fill" style="@GetWidthStyle(row.Percentage)">
                                        </div>
                                    </div>

                                    <div class="category-percentage">
                                        @row.Percentage.ToString("0")%
                                        of monthly expenses
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4">

            @* show the five most recent transactions *@
            <div class="col-xl-7">
                <div class="dashboard-card h-100">
                    <div class="card-heading card-heading-row">
                        <div>
                            <h2>Recent Transactions</h2>
                            <p>Your latest financial activity.</p>
                        </div>

                        <a href="/transactions" class="btn btn-sm btn-outline-primary">
                            View All
                        </a>
                    </div>

                    @if (recentTransactions.Count == 0)
                    {
                        <div class="empty-state">
                            <span class="bi bi-receipt"></span>

                            <p>
                                You have not recorded any transactions yet.
                            </p>

                            <a href="/transactions" class="btn btn-primary btn-sm">
                                Add Transaction
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table dashboard-table align-middle">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th>Category</th>
                                        <th>Date</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var transaction in recentTransactions)
                                    {
                                        <tr>
                                            <td>
                                                <div class="transaction-name">
                                                    @transaction.Description
                                                </div>

                                                <span class="badge
                                                    @(transaction.Type ==
                                                          TransactionType.Income
                                                          ? "text-bg-success"
                                                          : "text-bg-danger")">
                                                    @transaction.Type
                                                </span>
                                            </td>

                                            <td>
                                                @(transaction.Category?.Name
                                                    ?? "No category")
                                            </td>

                                            <td>
                                                @transaction.Date.ToString("MMM d, yyyy")
                                            </td>

                                            <td class="text-end fw-semibold
                                                @(transaction.Type ==
                                                    TransactionType.Income
                                                    ? "text-success"
                                                    : "text-danger")">
                                                @(transaction.Type ==
                                                    TransactionType.Income
                                                    ? "+"
                                                    : "-")@transaction.Amount.ToString("C")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            @* progress for each budget created this month *@
            <div class="col-xl-5">
                <div class="dashboard-card h-100">
                    <div class="card-heading card-heading-row">
                        <div>
                            <h2>Budget Progress</h2>
                            <p>
                                Your category budgets for @CurrentMonthName.
                            </p>
                        </div>

                        <a href="/budgets" class="btn btn-sm btn-outline-primary">
                            Manage
                        </a>
                    </div>

                    @if (budgetProgress.Count == 0)
                    {
                        <div class="empty-state">
                            <span class="bi bi-wallet2"></span>

                            <p>
                                You have not created any budgets for this month.
                            </p>

                            <a href="/budgets" class="btn btn-primary btn-sm">
                                Create Budget
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="budget-list">
                            @foreach (var row in budgetProgress)
                            {
                                <div class="budget-progress-row">
                                    <div class="budget-progress-heading">
                                        <div>
                                            <strong>@row.CategoryName</strong>

                                            <div class="small text-muted">
                                                @row.Spent.ToString("C")
                                                spent of
                                                @row.BudgetAmount.ToString("C")
                                            </div>
                                        </div>

                                        <span class="budget-status
                                            @(row.IsOverBudget
                                                  ? "text-danger"
                                                  : "text-success")">

                                            @if (row.IsOverBudget)
                                            {
                                                <span>
                                                    @Math.Abs(row.Remaining).ToString("C")
                                                    over
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @row.Remaining.ToString("C")
                                                    left
                                                </span>
                                            }
                                        </span>
                                    </div>

                                    <div class="progress budget-progress-bar">
                                        <div class="progress-bar
                                            @(row.IsOverBudget
                                                 ? "bg-danger"
                                                 : row.PercentageUsed >= 80
                                                     ? "bg-warning"
                                                     : "bg-success")" role="progressbar"
                                             style="@GetWidthStyle(row.ProgressWidth)" aria-valuenow="@row.ProgressWidth"
                                             aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>

                                    <div class="budget-percent">
                                        @row.PercentageUsed.ToString("0")% used
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
