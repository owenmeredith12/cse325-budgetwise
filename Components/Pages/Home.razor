</style>

@code {
    // lists used to store the data displayed on the dashboard
    private List<Transaction> allTransactions = [];
    private List<Transaction> recentTransactions = [];
    private List<CategorySpendingRow> categorySpending = [];
    private List<BudgetProgressRow> budgetProgress = [];
    private List<MonthlyReportRow> monthlyReports = [];

    // current user and page state
    private string? currentUserId;
    private string? errorMessage;
    private bool isLoading = true;

    // get the start and end dates for the current month
    private DateTime CurrentMonthStart =>
        new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private DateTime NextMonthStart =>
        CurrentMonthStart.AddMonths(1);

    // get the current month name for the dashboard
    private string CurrentMonthName =>
        CultureInfo.CurrentCulture.DateTimeFormat
            .GetMonthName(DateTime.Today.Month);

    // calculate the balance from every recorded transaction
    private decimal CurrentBalance =>
        allTransactions
            .Where(transaction =>
                transaction.Type == TransactionType.Income)
            .Sum(transaction => transaction.Amount)
        -
        allTransactions
            .Where(transaction =>
                transaction.Type == TransactionType.Expense)
            .Sum(transaction => transaction.Amount);

    // calculate income for only the current month
    private decimal CurrentMonthIncome =>
        allTransactions
            .Where(transaction =>
                transaction.Type == TransactionType.Income &&
                transaction.Date >= CurrentMonthStart &&
                transaction.Date < NextMonthStart)
            .Sum(transaction => transaction.Amount);

    // calculate expenses for only the current month
    private decimal CurrentMonthExpenses =>
        allTransactions
            .Where(transaction =>
                transaction.Type == TransactionType.Expense &&
                transaction.Date >= CurrentMonthStart &&
                transaction.Date < NextMonthStart)
            .Sum(transaction => transaction.Amount);

    // count income transactions from this month
    private int CurrentMonthIncomeCount =>
        allTransactions.Count(transaction =>
            transaction.Type == TransactionType.Income &&
            transaction.Date >= CurrentMonthStart &&
            transaction.Date < NextMonthStart);

    // count expense transactions from this month
    private int CurrentMonthExpenseCount =>
        allTransactions.Count(transaction =>
            transaction.Type == TransactionType.Expense &&
            transaction.Date >= CurrentMonthStart &&
            transaction.Date < NextMonthStart);

    // total amount budgeted for the current month
    private decimal CurrentMonthBudgetTotal =>
        budgetProgress.Sum(row => row.BudgetAmount);

    // calculate how much money remains across the monthly budgets
    private decimal TotalBudgetRemaining =>
        CurrentMonthBudgetTotal - CurrentMonthExpenses;

    // find the largest chart value so all bars use the same scale
    private decimal MonthlyChartMaximum =>
        Math.Max(
            monthlyReports
                .SelectMany(report => new[]
                {
                    report.Income,
                    report.Expenses
                })
                .DefaultIfEmpty(0)
                .Max(),
            1);

    // load the signed in user before loading dashboard data
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user =
                await UserManager.GetUserAsync(authenticationState.User);

            if (user is null)
            {
                errorMessage =
                    "You must be signed in to view the dashboard.";

                return;
            }

            currentUserId = user.Id;

            await LoadDashboardAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load the dashboard: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // load transactions and budgets for the current user
    private async Task LoadDashboardAsync()
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }

        await using var db =
            await DbFactory.CreateDbContextAsync();

        // load all transactions so they can be reused for the dashboard calculations
        allTransactions = await db.Transactions
            .AsNoTracking()
            .Include(transaction => transaction.Category)
            .Where(transaction =>
                transaction.UserId == currentUserId)
            .OrderByDescending(transaction => transaction.Date)
            .ThenByDescending(transaction => transaction.Id)
            .ToListAsync();

        // only show the newest five transactions in the recent activity section
        recentTransactions = allTransactions
            .Take(5)
            .ToList();

        BuildCategorySpending();
        BuildMonthlyReports();

        // load budgets created for the current month
        var budgets = await db.Budgets
            .AsNoTracking()
            .Include(budget => budget.Category)
            .Where(budget =>
                budget.UserId == currentUserId &&
                budget.Month == DateTime.Today.Month &&
                budget.Year == DateTime.Today.Year)
            .OrderBy(budget => budget.Category!.Name)
            .ToListAsync();

        // total this month's spending for each category
        var spendingByCategory = allTransactions
            .Where(transaction =>
                transaction.Type == TransactionType.Expense &&
                transaction.Date >= CurrentMonthStart &&
                transaction.Date < NextMonthStart)
            .GroupBy(transaction => transaction.CategoryId)
            .ToDictionary(
                group => group.Key,
                group => group.Sum(transaction => transaction.Amount));

        // combine each budget with the amount actually spent in its category
        budgetProgress = budgets
            .Select(budget => new BudgetProgressRow
            {
                CategoryName =
                    budget.Category?.Name ?? "Unknown category",

                BudgetAmount = budget.Amount,

                Spent = spendingByCategory.GetValueOrDefault(
                    budget.CategoryId,
                    0)
            })
            .ToList();
    }

    // group the current month's expenses by category
    private void BuildCategorySpending()
    {
        var groupedSpending = allTransactions
            .Where(transaction =>
                transaction.Type == TransactionType.Expense &&
                transaction.Date >= CurrentMonthStart &&
                transaction.Date < NextMonthStart)
            .GroupBy(transaction =>
                transaction.Category?.Name ?? "Uncategorized")
            .Select(group => new
            {
                CategoryName = group.Key,
                Amount = group.Sum(transaction => transaction.Amount)
            })
            .OrderByDescending(row => row.Amount)
            .ToList();

        var totalExpenses =
            groupedSpending.Sum(row => row.Amount);

        // calculate what percentage of spending each category represents
        categorySpending = groupedSpending
            .Select(row => new CategorySpendingRow
            {
                CategoryName = row.CategoryName,
                Amount = row.Amount,

                Percentage = totalExpenses <= 0
                    ? 0
                    : row.Amount / totalExpenses * 100
            })
            .ToList();
    }

    // create income and expense totals for the last six months
    private void BuildMonthlyReports()
    {
        monthlyReports = [];

        for (var monthsBack = 5; monthsBack >= 0; monthsBack--)
        {
            var monthStart =
                CurrentMonthStart.AddMonths(-monthsBack);

            var monthEnd =
                monthStart.AddMonths(1);

            monthlyReports.Add(new MonthlyReportRow
            {
                MonthLabel = monthStart.ToString("MMM"),

                Income = allTransactions
                    .Where(transaction =>
                        transaction.Type == TransactionType.Income &&
                        transaction.Date >= monthStart &&
                        transaction.Date < monthEnd)
                    .Sum(transaction => transaction.Amount),

                Expenses = allTransactions
                    .Where(transaction =>
                        transaction.Type == TransactionType.Expense &&
                        transaction.Date >= monthStart &&
                        transaction.Date < monthEnd)
                    .Sum(transaction => transaction.Amount)
            });
        }
    }

    // convert a dollar amount into a percentage height for the chart
    private string GetBarHeightStyle(decimal amount)
    {
        var percentage =
            amount <= 0
                ? 0
                : amount / MonthlyChartMaximum * 100;

        return $"height: {Math.Max(percentage, amount > 0 ? 2 : 0):0.##}%;";
    }

    // keep progress bars between zero and one hundred percent
    private static string GetWidthStyle(decimal percentage)
    {
        var limitedPercentage =
            Math.Clamp(percentage, 0, 100);

        return $"width: {limitedPercentage:0.##}%;";
    }

    // shorten larger dollar values so they fit above the chart bars
    private static string FormatShortCurrency(decimal amount)
    {
        if (amount >= 1_000_000)
        {
            return $"${amount / 1_000_000:0.#}M";
        }

        if (amount >= 1_000)
        {
            return $"${amount / 1_000:0.#}K";
        }

        return amount.ToString("C0");
    }

    // represents one row in the category spending section
    private sealed class CategorySpendingRow
    {
        public string CategoryName { get; init; } = string.Empty;
        public decimal Amount { get; init; }
        public decimal Percentage { get; init; }
    }

    // stores one month's income and expense totals
    private sealed class MonthlyReportRow
    {
        public string MonthLabel { get; init; } = string.Empty;
        public decimal Income { get; init; }
        public decimal Expenses { get; init; }
    }

    // stores the calculated values used by each budget progress bar
    private sealed class BudgetProgressRow
    {
        public string CategoryName { get; init; } = string.Empty;
        public decimal BudgetAmount { get; init; }
        public decimal Spent { get; init; }

        public decimal Remaining =>
            BudgetAmount - Spent;

        public decimal PercentageUsed =>
            BudgetAmount <= 0
                ? 0
                : Spent / BudgetAmount * 100;

        public decimal ProgressWidth =>
            Math.Min(PercentageUsed, 100);

        public bool IsOverBudget =>
            Spent > BudgetAmount;
    }
}

