        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        background: #ffffff;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
    }

    .summary-card {
        padding: 1.35rem;
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        border-radius: 0.8rem;
        font-size: 1.15rem;
    }

    .balance-icon {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .income-icon {
        background: #dcfce7;
        color: #15803d;
    }

    .expense-icon {
        background: #fee2e2;
        color: #b91c1c;
    }

    .budget-icon {
        background: #ede9fe;
