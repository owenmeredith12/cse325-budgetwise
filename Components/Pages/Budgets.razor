@page "/budgets"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using cse325_budgetwise.Data
@using cse325_budgetwise.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Budgets</PageTitle>

<div class="container py-4">

    <div class="mb-4">
        <h1>Budgets</h1>
        <p class="text-muted">
            Set monthly spending limits and compare them with your actual expenses.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    @if (isLoading)
    {
        <p>Loading budgets...</p>
    }
    else
    {
        <!-- ADD / EDIT BUDGET -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h2 class="h5 mb-3">
                    @(IsEditing ? "Edit Budget" : "Add Budget")
                </h2>

                @if (expenseCategories.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        You need at least one expense category before creating a budget.

                        <a href="/categories" class="alert-link">
                            Create an expense category
                        </a>
                    </div>
                }
                else
                {
                    <EditForm Model="budgetForm" OnValidSubmit="SaveBudgetAsync" FormName="BudgetForm">

                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="row g-3">

                            <div class="col-md-4">
                                <label for="budgetCategory" class="form-label">
                                    Expense category
                                </label>

                                <InputSelect id="budgetCategory" class="form-select" @bind-Value="budgetForm.CategoryId">

                                    <option value="0">
                                        Select a category
                                    </option>

                                    @foreach (var category in expenseCategories)
                                    {
                                        <option value="@category.Id">
                                            @category.Name
                                        </option>
                                    }

                                </InputSelect>

                                <ValidationMessage For="() => budgetForm.CategoryId" class="text-danger" />
                            </div>

                            <div class="col-md-3">
                                <label for="budgetAmount" class="form-label">
                                    Budget amount
                                </label>

                                <InputNumber id="budgetAmount" class="form-control" @bind-Value="budgetForm.Amount" min="0.01"
                                             step="0.01" />

                                <ValidationMessage For="() => budgetForm.Amount" class="text-danger" />
                            </div>

                            <div class="col-md-2">
                                <label for="budgetMonth" class="form-label">
                                    Month
                                </label>

                                <InputSelect id="budgetMonth" class="form-select" @bind-Value="budgetForm.Month">

                                    @foreach (var month in Enumerable.Range(1, 12))
                                    {
                                        <option value="@month">
                                            @GetMonthName(month)
                                        </option>
                                    }

                                </InputSelect>

                                <ValidationMessage For="() => budgetForm.Month" class="text-danger" />
                            </div>

                            <div class="col-md-3">
                                <label for="budgetYear" class="form-label">
                                    Year
                                </label>

                                <InputSelect id="budgetYear" class="form-select" @bind-Value="budgetForm.Year">

                                    @foreach (var year in AvailableYears)
                                    {
                                        <option value="@year">
                                            @year
                                        </option>
                                    }

                                </InputSelect>

                                <ValidationMessage For="() => budgetForm.Year" class="text-danger" />
                            </div>

                            <div class="col-12 d-flex gap-2">

                                <button type="submit" class="btn btn-primary" disabled="@isSaving">

                                    @if (isSaving)
                                    {
                                        @(IsEditing
                                            ? "Saving..."
                                            : "Adding...")
                                    }
                                    else
                                    {
                                        @(IsEditing
                                            ? "Save Changes"
                                            : "Add Budget")
                                    }

                                </button>

                                @if (IsEditing)
                                {
                                    <button type="button" class="btn btn-outline-secondary" disabled="@isSaving"
                                            @onclick="CancelEdit">
                                        Cancel
                                    </button>
                                }

                            </div>

                        </div>

                    </EditForm>
                }

            </div>
        </div>


        <!-- BUDGET LIST -->
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="d-flex flex-wrap
                    justify-content-between
                    align-items-center
                    gap-3 mb-3">

                    <h2 class="h5 mb-0">
                        Your Budgets
                    </h2>

                    <div class="d-flex gap-2">

                        <InputSelect class="form-select" @bind-Value="filterMonth" @bind-Value:after="LoadBudgetsAsync">

                            @foreach (var month in Enumerable.Range(1, 12))
                            {
                                <option value="@month">
                                    @GetMonthName(month)
                                </option>
                            }

                        </InputSelect>

                        <InputSelect class="form-select" @bind-Value="filterYear" @bind-Value:after="LoadBudgetsAsync">

                            @foreach (var year in AvailableYears)
                            {
                                <option value="@year">
                                    @year
                                </option>
                            }

                        </InputSelect>

                    </div>

                </div>

                @if (budgetRows.Count == 0)
                {
                    <div class="alert alert-light border mb-0">
                        You have not created any budgets for
                        @SelectedFilterMonthName @filterYear.
                    </div>
                }
                else
                {
                    <div class="row g-3">

                        @foreach (var row in budgetRows)
                        {
                            <div class="col-lg-6">

                                <div class="card h-100 border">
                                    <div class="card-body">

                                        <div class="d-flex
                                            justify-content-between
                                            align-items-start
                                            gap-3 mb-3">

                                            <div>
                                                <h3 class="h5 mb-1">
                                                    @row.Budget.Category?.Name
                                                </h3>

                                                <div class="text-muted small">
                                                    @GetMonthName(row.Budget.Month)
                                                    @row.Budget.Year
                                                </div>
                                            </div>

                                            <div class="d-flex gap-2">

                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        disabled="@(isSaving || isDeleting)" @onclick="() => StartEdit(row.Budget)">
                                                    Edit
                                                </button>

                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        disabled="@(isSaving || isDeleting)"
                                                        @onclick="() => DeleteBudgetAsync(row.Budget.Id)">
                                                    Delete
                                                </button>

                                            </div>

                                        </div>


                                        <div class="row g-3 mb-3">

                                            <div class="col-4">
                                                <div class="text-muted small">
                                                    Budget
                                                </div>

                                                <div class="fw-semibold">
                                                    @(row.Budget.Amount.ToString("C"))
                                                </div>
                                            </div>

                                            <div class="col-4">
                                                <div class="text-muted small">
                                                    Spent
                                                </div>

                                                <div class="fw-semibold">
                                                    @(row.Spent.ToString("C"))
                                                </div>
                                            </div>

                                            <div class="col-4">
                                                <div class="text-muted small">
                                                    @(row.Remaining >= 0
                                                        ? "Remaining"
                                                        : "Over Budget")
                                                </div>

                                                <div class="fw-semibold @(row.Remaining >= 0
                                                                                                         ? "text-success"
                                                                                                         : "text-danger")">

                                                    @(Math.Abs(row.Remaining).ToString("C"))

                                                </div>
                                            </div>

                                        </div>


                                        <div class="progress" style="height: 12px;">

                                            <div class="progress-bar @(row.IsOverBudget
                                                                                                     ? "bg-danger"
                                                                                                     : row.PercentageUsed >= 80
                                                                                                         ? "bg-warning"
                                                                                                         : "bg-success")" role="progressbar"
                                                 style="@GetProgressStyle(row.ProgressWidth)" aria-valuenow="@row.ProgressWidth"
                                                 aria-valuemin="0" aria-valuemax="100">
                                            </div>

                                        </div>


                                        <div class="d-flex
                                            justify-content-between
                                            mt-2
                                            small
                                            text-muted">

                                            <span>
                                                @(row.PercentageUsed.ToString("0"))% used
                                            </span>

                                            @if (row.IsOverBudget)
                                            {
                                                <span class="text-danger">
                                                    Budget exceeded
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @(row.Remaining.ToString("C")) available
                                                </span>
                                            }

                                        </div>

                                    </div>
                                </div>

                            </div>
                        }

                    </div>
                }

            </div>
        </div>
    }

</div>


@code {

    // Form binding for normal server POSTs as well as interactive use.
    [SupplyParameterFromForm(FormName = "BudgetForm")]
    private BudgetFormModel budgetForm { get; set; } = new();


    private List<Category> expenseCategories = [];
    private List<BudgetRow> budgetRows = [];

    private string? currentUserId;
    private string? errorMessage;
    private string? successMessage;

    private bool isLoading = true;
    private bool isSaving;
    private bool isDeleting;

    private int filterMonth = DateTime.Today.Month;
    private int filterYear = DateTime.Today.Year;


    private bool IsEditing =>
        budgetForm.BudgetId > 0;


    private IEnumerable<int> AvailableYears =>
        Enumerable.Range(
            DateTime.Today.Year - 2,
            6);


    private string SelectedFilterMonthName =>
        GetMonthName(filterMonth);


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user =
                await UserManager.GetUserAsync(
                    authenticationState.User);

            if (user is null)
            {
                errorMessage =
                    "You must be signed in to manage budgets.";

                return;
            }

            currentUserId = user.Id;

            await LoadExpenseCategoriesAsync();

            // Only initialize a blank form if this wasn't a posted form.
            if (budgetForm.Month <= 0)
            {
                ResetForm();
            }

            await LoadBudgetsAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load budgets: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task LoadExpenseCategoriesAsync()
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }

        await using var db =
            await DbFactory.CreateDbContextAsync();

        expenseCategories = await db.Categories
            .AsNoTracking()
            .Where(category =>
                category.UserId == currentUserId &&
                category.Type == TransactionType.Expense)
            .OrderBy(category => category.Name)
            .ToListAsync();
    }


    private async Task LoadBudgetsAsync()
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }

        await using var db =
            await DbFactory.CreateDbContextAsync();

        var budgets = await db.Budgets
            .AsNoTracking()
            .Include(budget => budget.Category)
            .Where(budget =>
                budget.UserId == currentUserId &&
                budget.Month == filterMonth &&
                budget.Year == filterYear)
            .OrderBy(budget =>
                budget.Category!.Name)
            .ToListAsync();


        // PostgreSQL timestamptz expects UTC DateTime values.
        var startDate =
            new DateTime(
                filterYear,
                filterMonth,
                1,
                0,
                0,
                0,
                DateTimeKind.Utc);

        var endDate =
            startDate.AddMonths(1);


        var spendingByCategory =
            await db.Transactions
                .AsNoTracking()
                .Where(transaction =>
                    transaction.UserId == currentUserId &&
                    transaction.Type == TransactionType.Expense &&
                    transaction.Date >= startDate &&
                    transaction.Date < endDate)
                .GroupBy(transaction =>
                    transaction.CategoryId)
                .Select(group => new
                {
                    CategoryId = group.Key,

                    Spent = group.Sum(
                        transaction =>
                            transaction.Amount)
                })
                .ToDictionaryAsync(
                    item => item.CategoryId,
                    item => item.Spent);


        budgetRows = budgets
            .Select(budget =>
                new BudgetRow
                {
                    Budget = budget,

                    Spent =
                        spendingByCategory
                            .GetValueOrDefault(
                                budget.CategoryId,
                                0)
                })
            .ToList();
    }


    private async Task SaveBudgetAsync()
    {
        ClearMessages();

        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            errorMessage =
                "You must be signed in to save a budget.";

            return;
        }

        isSaving = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var category =
                await db.Categories
                    .AsNoTracking()
                    .FirstOrDefaultAsync(category =>
                        category.Id ==
                            budgetForm.CategoryId &&
                        category.UserId ==
                            currentUserId &&
                        category.Type ==
                            TransactionType.Expense);


            if (category is null)
            {
                errorMessage =
                    "Select a valid expense category.";

                return;
            }


            var duplicateBudget =
                await db.Budgets
                    .AsNoTracking()
                    .AnyAsync(budget =>
                        budget.UserId ==
                            currentUserId &&
                        budget.CategoryId ==
                            budgetForm.CategoryId &&
                        budget.Month ==
                            budgetForm.Month &&
                        budget.Year ==
                            budgetForm.Year &&
                        budget.Id !=
                            budgetForm.BudgetId);


            if (duplicateBudget)
            {
                errorMessage =
                    "A budget already exists for that category and month.";

                return;
            }


            if (budgetForm.BudgetId > 0)
            {
                var budget =
                    await db.Budgets
                        .FirstOrDefaultAsync(budget =>
                            budget.Id ==
                                budgetForm.BudgetId &&
                            budget.UserId ==
                                currentUserId);


                if (budget is null)
                {
                    errorMessage =
                        "The budget could not be found.";

                    return;
                }


                budget.Amount =
                    budgetForm.Amount;

                budget.Month =
                    budgetForm.Month;

                budget.Year =
                    budgetForm.Year;

                budget.CategoryId =
                    budgetForm.CategoryId;


                successMessage =
                    "Budget updated successfully.";
            }
            else
            {
                var budget = new Budget
                {
                    Amount =
                        budgetForm.Amount,

                    Month =
                        budgetForm.Month,

                    Year =
                        budgetForm.Year,

                    CategoryId =
                        budgetForm.CategoryId,

                    UserId =
                        currentUserId
                };


                db.Budgets.Add(budget);


                successMessage =
                    "Budget added successfully.";
            }


            await db.SaveChangesAsync();


            filterMonth =
                budgetForm.Month;

            filterYear =
                budgetForm.Year;


            ResetForm();

            await LoadBudgetsAsync();
        }
        catch (DbUpdateException ex)
        {
            errorMessage =
                $"The budget could not be saved: " +
                $"{ex.InnerException?.Message ?? ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to save budget: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }


    private void StartEdit(Budget budget)
    {
        ClearMessages();

        budgetForm =
            new BudgetFormModel
            {
                BudgetId =
                    budget.Id,

                Amount =
                    budget.Amount,

                Month =
                    budget.Month,

                Year =
                    budget.Year,

                CategoryId =
                    budget.CategoryId
            };
    }


    private void CancelEdit()
    {
        ClearMessages();

        ResetForm();
    }


    private async Task DeleteBudgetAsync(
        int budgetId)
    {
        ClearMessages();

        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            errorMessage =
                "You must be signed in to delete a budget.";

            return;
        }


        isDeleting = true;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var budget =
                await db.Budgets
                    .FirstOrDefaultAsync(budget =>
                        budget.Id ==
                            budgetId &&
                        budget.UserId ==
                            currentUserId);


            if (budget is null)
            {
                errorMessage =
                    "The budget could not be found.";

                return;
            }


            db.Budgets.Remove(budget);

            await db.SaveChangesAsync();


            if (budgetForm.BudgetId ==
                budgetId)
            {
                ResetForm();
            }


            successMessage =
                "Budget deleted successfully.";


            await LoadBudgetsAsync();
        }
        catch (DbUpdateException ex)
        {
            errorMessage =
                $"Unable to delete budget: " +
                $"{ex.InnerException?.Message ?? ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to delete budget: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
        }
    }


    private void ResetForm()
    {
        budgetForm =
            new BudgetFormModel
            {
                BudgetId = 0,

                Month =
                    DateTime.Today.Month,

                Year =
                    DateTime.Today.Year,

                CategoryId =
                    expenseCategories
                        .FirstOrDefault()?.Id ?? 0
            };
    }


    private static string GetMonthName(
        int month)
    {
        return CultureInfo
            .CurrentCulture
            .DateTimeFormat
            .GetMonthName(month);
    }


    private static string GetProgressStyle(
        decimal percentage)
    {
        var width =
            Math.Clamp(
                percentage,
                0,
                100);

        return $"width: {width:0.##}%;";
    }


    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }


    private sealed class BudgetFormModel
    {
        public int BudgetId { get; set; }


        [Range(
            typeof(decimal),
            "0.01",
            "999999999.99",
            ErrorMessage =
                "Enter a budget amount greater than zero.")]

        public decimal Amount { get; set; }


        [Range(
            1,
            12,
            ErrorMessage =
                "Select a valid month.")]

        public int Month { get; set; } =
            DateTime.Today.Month;


        [Range(
            2000,
            2100,
            ErrorMessage =
                "Select a valid year.")]

        public int Year { get; set; } =
            DateTime.Today.Year;


        [Range(
            1,
            int.MaxValue,
            ErrorMessage =
                "Select an expense category.")]

        public int CategoryId { get; set; }
    }


    private sealed class BudgetRow
    {
        public required Budget Budget
        {
            get;
            init;
        }


        public decimal Spent
        {
            get;
            init;
        }


        public decimal Remaining =>
            Budget.Amount - Spent;


        public bool IsOverBudget =>
            Spent > Budget.Amount;


        public decimal PercentageUsed =>
            Budget.Amount <= 0
                ? 0
                : Spent /
                  Budget.Amount *
                  100;


        public decimal ProgressWidth =>
            Math.Min(
                PercentageUsed,
                100);
    }
}